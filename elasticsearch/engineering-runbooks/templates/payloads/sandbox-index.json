{
  "settings": {
    "number_of_shards": 2,
    "number_of_replicas": 1,
    "refresh_interval": "60s"
  },
  "mappings": {
    "dynamic": "strict",
    "properties": {
      "record_id": {
        "type": "keyword"
      },
      "event_time": {
        "type": "date"
      },
      "event_type": {
        "type": "keyword"
      },
      "summary": {
        "type": "text"
      }
    }
  }
}
